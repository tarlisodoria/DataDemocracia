{
  "name": "datademocracia",
  "version": "1.0.0",
  "description": "Plataforma cívica independente que organiza dados públicos sobre a política brasileira com fonte, contexto e evidência.",
  "author": "Tarliso Doria",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarlisodoria/DataDemocracia.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "deploy": "pnpm build && wrangler deploy",
    "dados:votacoes": "node scripts/coletar-votacoes-camara.mjs",
    "dados:cota": "node scripts/coletar-cota-camara.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.9.0-beta",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "5.5.1",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.4",
    "wrangler": "^4.156.1"
  },
  "packageManager": "pnpm@10.18.0"
}
